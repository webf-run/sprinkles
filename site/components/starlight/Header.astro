---
import Search from '@astrojs/starlight/components/Search.astro';
import { ChevronDown, Github, Sun, Moon } from 'lucide-astro';

import Logo from '../../assets/sprinkles.svg';
import { Links } from '../../data/Constant';

const trim = (path: string) => path.replace(/\/$/, '') || '/';
const pathname = trim(Astro.url.pathname);
const isComponents = pathname === trim(Links.components);
const isBlocks = pathname === trim(Links.blocks);

const links = [
  { label: 'Home', href: Links.home, active: pathname === '/' },
  {
    label: 'Docs',
    href: Links.gettingStarted,
    active: pathname !== '/' && !isComponents && !isBlocks,
  },
  { label: 'Components', href: Links.components, active: isComponents },
  { label: 'Blocks', href: Links.blocks, active: isBlocks },
];
---

<div class:list={['h-full w-full']}>
  <div
    class:list={[
      'grid h-full w-full grid-cols-[auto_1fr_auto] items-center',
      'gap-6',
    ]}
  >
    <!-- Logo -->
    <div>
      <a
        href='/'
        class:list={[
          'inline-flex items-center gap-2 no-underline',
          'text-xl font-bold tracking-tight',
          'text-(--sl-color-white)',
          'transition-opacity duration-200 hover:opacity-85',
        ]}
      >
        <Logo class:list={['size-6 shrink-0']} aria-hidden='true' />
        <span class:list={['text-(--sl-color-white)']}>Sprinkles</span>
      </a>
    </div>

    <!-- Navigation -->
    <nav
      aria-label='Main'
      class:list={['hidden items-center justify-start gap-1', 'md:flex']}
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.active ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-1.5',
              'text-sm font-medium no-underline',
              'transition-colors duration-150',
              link.active
                ? 'bg-(--sl-color-accent-low) text-(--sl-color-text-accent)'
                : [
                    'text-(--sl-color-gray-3)',
                    'hover:bg-(--sl-color-gray-6)',
                    'hover:text-(--sl-color-white)',
                  ],
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right -->
    <div class:list={['flex items-center justify-end gap-2']}>
      <!-- Search -->
      <div class:list={['w-auto', 'sm:w-44', 'lg:w-60']}>
        <Search />
      </div>

      <!-- GitHub -->
      <a
        href={Links.repo}
        target='_blank'
        rel='noopener noreferrer'
        class:list={[
          'grid h-9 w-9 place-items-center',
          'rounded-lg border border-transparent',
          'bg-transparent',
          'text-(--sl-color-gray-3)',
          'no-underline',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
        aria-label='GitHub'
      >
        <Github size={18} />
      </a>

      <!-- Component theme: re-skins every example with another site's token values. -->
      <label
        class:list={[
          'hidden items-center gap-2 text-sm text-(--sl-color-gray-3)',
          'lg:flex',
        ]}
      >
        <span>Theme</span>
        <div class:list={['relative']}>
          <select
            id='sprinkles-theme'
            class:list={[
              'h-9 appearance-none rounded-lg border border-(--sl-color-gray-5)',
              'bg-(--sl-color-bg) pr-9 pl-3',
              'text-sm text-(--sl-color-white)',
            ]}
          >
            <option value='default'>Sprinkles</option>
            <option value='studio'>Studio</option>
          </select>
          <ChevronDown
            size={16}
            aria-hidden='true'
            class:list={[
              'pointer-events-none absolute top-1/2 right-3 -translate-y-1/2',
            ]}
          />
        </div>
      </label>

      <!-- Theme toggle -->
      <button
        id='theme-toggle'
        type='button'
        class:list={[
          'grid h-9 w-9 place-items-center',
          'rounded-lg border border-transparent',
          'bg-transparent',
          'p-0',
          'text-(--sl-color-gray-3)',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
        aria-label='Toggle theme'
      >
        <Sun id='theme-icon-sun' size={18} class:list={['block']} />

        <Moon id='theme-icon-moon' size={18} class:list={['hidden']} />
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // The component theme, applied before paint so examples don't flash.
  (() => {
    const select = document.getElementById('sprinkles-theme');
    const apply = (theme) => {
      if (theme === 'default')
        delete document.documentElement.dataset.sprinklesTheme;
      else document.documentElement.dataset.sprinklesTheme = theme;
    };
    let saved = 'default';
    try {
      saved = localStorage.getItem('sprinkles-theme') ?? 'default';
    } catch {}
    apply(saved);
    if (select) select.value = saved;
    select?.addEventListener('change', () => {
      apply(select.value);
      try {
        localStorage.setItem('sprinkles-theme', select.value);
      } catch {}
    });
  })();

  const btn = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateIcon(theme) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('starlight-theme', theme);

    sunIcon?.classList.toggle('hidden', theme === 'dark');
    sunIcon?.classList.toggle('block', theme !== 'dark');

    moonIcon?.classList.toggle('hidden', theme !== 'dark');
    moonIcon?.classList.toggle('block', theme === 'dark');
  }

  const saved =
    localStorage.getItem('starlight-theme') ??
    (window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light');

  updateIcon(saved);

  btn?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

    updateIcon(next);
  });
</script>
