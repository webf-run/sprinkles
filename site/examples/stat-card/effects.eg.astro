---
import { Activity, Sparkles } from '@lucide/astro';
import { StatCard } from '@webf/sprinkles';
---

<div class:list={['grid grid-cols-2 gap-4']}>
  <StatCard effect='lift' icon={Activity} value='24%' label='Lift on hover' />

  <StatCard effect='glow' icon={Sparkles} value='4.9' label='Glow on hover' />
</div>
