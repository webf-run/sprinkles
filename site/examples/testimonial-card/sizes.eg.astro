---
import { TestimonialCard } from '@webf/sprinkles';
---

<div class:list={['grid gap-4 md:grid-cols-3']}>
  <TestimonialCard
    size='sm'
    variant='muted'
    quote='Compact and clean for dense testimonial grids.'
    name='Liam Brooks'
    role='PM, Fieldkit'
  />
  <TestimonialCard
    size='md'
    variant='muted'
    quote='The default size works well as a standalone highlight on a landing page.'
    name='Noor Haddad'
    role='Marketing Lead, Basil & Co.'
  />
  <TestimonialCard
    size='lg'
    variant='muted'
    quote='Great for a single hero testimonial that needs more breathing room and a longer quote.'
    name='Marcus Feld'
    role='CEO, Northbound'
  />
</div>
