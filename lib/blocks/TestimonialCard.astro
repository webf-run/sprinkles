---
import { Quote, Star } from '@lucide/astro';
import { cva, type VariantProps } from 'class-variance-authority';

const testimonialCardVariants = cva(
  'flex w-full flex-col rounded-3xl border transition-shadow duration-200',
  {
    variants: {
      variant: {
        default: 'border-border bg-surface',
        muted: 'border-border bg-surface-muted',
        accent: 'border-surface-accent-strong bg-surface-accent',
        inverse: 'border-accent bg-accent text-accent-foreground',
        purple: 'border-badge-purple-background bg-badge-purple-background',
        orange: 'border-badge-orange-background bg-badge-orange-background',
        green: 'border-badge-green-background bg-badge-green-background',
        blue: 'border-badge-blue-background bg-badge-blue-background',
        neutral: 'border-badge-neutral-background bg-badge-neutral-background',
      },

      size: {
        sm: 'gap-3 px-5 py-4',
        md: 'gap-4 px-6 py-5',
        lg: 'gap-5 px-8 py-7',
      },

      effect: {
        none: '',
        lift: 'hover:-translate-y-1 hover:shadow-lg',
        glow: 'hover:shadow-md hover:shadow-primary/25',
      },
    },

    defaultVariants: {
      variant: 'default',
      size: 'md',
      effect: 'none',
    },
  }
);

const testimonialCardTextVariants = cva('', {
  variants: {
    variant: {
      default: 'text-foreground',
      muted: 'text-foreground',
      accent: 'text-foreground',
      inverse: 'text-accent-foreground',
      purple: 'text-badge-purple-foreground',
      orange: 'text-badge-orange-foreground',
      green: 'text-badge-green-foreground',
      blue: 'text-badge-blue-foreground',
      neutral: 'text-badge-neutral-foreground',
    },
  },

  defaultVariants: {
    variant: 'default',
  },
});

const testimonialCardAccentVariants = cva('', {
  variants: {
    variant: {
      default: 'text-foreground-subtle',
      muted: 'text-foreground-subtle',
      accent: 'text-primary',
      inverse: 'text-accent-foreground/70',
      purple: 'text-badge-purple-foreground',
      orange: 'text-badge-orange-foreground',
      green: 'text-badge-green-foreground',
      blue: 'text-badge-blue-foreground',
      neutral: 'text-badge-neutral-foreground',
    },
  },

  defaultVariants: {
    variant: 'default',
  },
});

interface Props extends VariantProps<typeof testimonialCardVariants> {
  quote: string;
  name: string;
  role?: string;
  avatar?: string;
  rating?: number;
  class?: string;
}

const {
  quote,
  name,
  role,
  avatar,
  rating,
  variant,
  size,
  effect,
  class: className = '',
} = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');

const clampedRating =
  typeof rating === 'number'
    ? Math.min(5, Math.max(0, Math.round(rating)))
    : undefined;
---

<figure
  class:list={[testimonialCardVariants({ variant, size, effect }), className]}
>
  <Quote
    class:list={[
      'shrink-0',
      size === 'sm' && 'size-6',
      size === 'md' && 'size-7',
      size === 'lg' && 'size-8',
      testimonialCardAccentVariants({ variant }),
    ]}
    fill='currentColor'
    stroke='none'
  />

  {
    clampedRating !== undefined && (
      <div
        class:list={['flex items-center gap-0.5']}
        aria-label={`Rated ${clampedRating} out of 5`}
      >
        {Array.from({ length: 5 }).map((_, i) => (
          <Star
            class:list={[
              size === 'sm' ? 'size-3.5' : 'size-4',
              i < clampedRating
                ? testimonialCardAccentVariants({ variant })
                : 'text-border-subtle',
            ]}
            fill={i < clampedRating ? 'currentColor' : 'none'}
            stroke-width={1.75}
          />
        ))}
      </div>
    )
  }

  <blockquote
    class:list={[
      'flex-1 leading-relaxed font-medium',
      size === 'sm' && 'text-sm',
      size === 'md' && 'text-base',
      size === 'lg' && 'text-lg',
      testimonialCardTextVariants({ variant }),
    ]}
  >
    {quote}
  </blockquote>

  <figcaption class:list={['mt-1 flex items-center gap-3']}>
    {
      avatar ? (
        <img
          src={avatar}
          alt={name}
          class:list={[
            'shrink-0 rounded-full object-cover',
            size === 'sm' ? 'size-9' : size === 'lg' ? 'size-12' : 'size-10',
          ]}
        />
      ) : (
        <span
          class:list={[
            'flex shrink-0 items-center justify-center rounded-full font-semibold',
            size === 'sm'
              ? 'size-9 text-xs'
              : size === 'lg'
                ? 'size-12 text-sm'
                : 'size-10 text-xs',
            testimonialCardAccentVariants({ variant }),
            'bg-current/10',
          ]}
        >
          <span class:list={[testimonialCardTextVariants({ variant })]}>
            {initials}
          </span>
        </span>
      )
    }

    <div class:list={['flex min-w-0 flex-col']}>
      <span
        class:list={[
          'truncate leading-normal font-semibold',
          size === 'sm' && 'text-sm',
          size === 'md' && 'text-sm',
          size === 'lg' && 'text-base',
          testimonialCardTextVariants({ variant }),
        ]}
      >
        {name}
      </span>

      {
        role && (
          <span
            class:list={[
              'truncate text-xs leading-normal opacity-70',
              testimonialCardTextVariants({ variant }),
            ]}
          >
            {role}
          </span>
        )
      }
    </div>
  </figcaption>
</figure>
