---
import { Link, Navbar } from '@webf/sprinkles';

const navItems = [
  { label: 'Product', href: '/product' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Customers', href: '/customers' },
];
---

<Navbar logoText='Astro UI' navItems={navItems} position='static'>
  <Fragment slot='actions'>
    <Link href='/login' variant='blackwhite' size='sm'> Login </Link>

    <Link href='/signup' variant='purple' size='sm'> Apply Now </Link>
  </Fragment>
</Navbar>
