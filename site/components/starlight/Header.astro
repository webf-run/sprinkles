---
import Search from '@astrojs/starlight/components/Search.astro';
import { Github, Sun, Moon } from 'lucide-astro';
---

<div class:list={['h-full w-full']}>
  <div
    class:list={[
      'grid h-full w-full grid-cols-[auto_1fr_auto] items-center',
      'gap-6',
    ]}
  >
    <!-- Logo -->
    <div>
      <a
        href='/'
        class:list={[
          'inline-flex items-center gap-2 no-underline',
          'text-xl font-bold tracking-tight',
          'text-(--sl-color-white)',
          'transition-opacity duration-200 hover:opacity-85',
        ]}
      >
        <span class:list={['text-(--sl-color-white)']}> Astro </span>

        <span
          class:list={[
            'rounded-md px-2 py-0.5',
            'text-[13px] font-semibold tracking-normal',
            'bg-(--sl-color-accent-low)',
            'text-(--sl-color-accent-high)',
          ]}
        >
          UI
        </span>
      </a>
    </div>

    <!-- Navigation -->
    <nav class:list={['hidden items-center justify-start gap-1', 'md:flex']}>
      <a
        href='/'
        class:list={[
          'rounded-lg px-3 py-1.5',
          'text-sm font-medium no-underline',
          'text-(--sl-color-text-accent)',
          'bg-(--sl-color-accent-low)',
          'transition-colors duration-150',
        ]}
      >
        Home
      </a>

      <a
        href='/docs'
        class:list={[
          'rounded-lg px-3 py-1.5',
          'text-sm font-medium no-underline',
          'text-(--sl-color-gray-3)',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
      >
        Docs
      </a>

      <a
        href='/components'
        class:list={[
          'rounded-lg px-3 py-1.5',
          'text-sm font-medium no-underline',
          'text-(--sl-color-gray-3)',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
      >
        Components
      </a>
    </nav>

    <!-- Right -->
    <div class:list={['flex items-center justify-end gap-2']}>
      <!-- Search -->
      <div class:list={['w-auto', 'sm:w-44', 'lg:w-60']}>
        <Search />
      </div>

      <!-- GitHub -->
      <a
        href='https://github.com/webf-run/astro-ui'
        target='_blank'
        rel='noopener noreferrer'
        class:list={[
          'grid h-9 w-9 place-items-center',
          'rounded-lg border border-transparent',
          'bg-transparent',
          'text-(--sl-color-gray-3)',
          'no-underline',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
        aria-label='GitHub'
      >
        <Github size={18} />
      </a>

      <!-- Theme toggle -->
      <button
        id='theme-toggle'
        type='button'
        class:list={[
          'grid h-9 w-9 place-items-center',
          'rounded-lg border border-transparent',
          'bg-transparent',
          'p-0',
          'text-(--sl-color-gray-3)',
          'transition-colors duration-150',
          'hover:bg-(--sl-color-gray-6)',
          'hover:text-(--sl-color-white)',
        ]}
        aria-label='Toggle theme'
      >
        <Sun id='theme-icon-sun' size={18} class:list={['block']} />

        <Moon id='theme-icon-moon' size={18} class:list={['hidden']} />
      </button>
    </div>
  </div>
</div>

<script is:inline>
  const btn = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  function updateIcon(theme) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('starlight-theme', theme);

    sunIcon?.classList.toggle('hidden', theme === 'dark');
    sunIcon?.classList.toggle('block', theme !== 'dark');

    moonIcon?.classList.toggle('hidden', theme !== 'dark');
    moonIcon?.classList.toggle('block', theme === 'dark');
  }

  const saved =
    localStorage.getItem('starlight-theme') ??
    (window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light');

  updateIcon(saved);

  btn?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

    updateIcon(next);
  });
</script>
