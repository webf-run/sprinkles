---
import Default from '@astrojs/starlight/components/Sidebar.astro';

import { getSection, sections } from '../../data/Sections';

const current = getSection(Astro.url.pathname);
---

{/* Phones hide the header nav, so offer the same sections here. */}
<nav aria-label='Sections' class:list={['mb-4 flex flex-wrap gap-1', 'md:hidden']}>
  {
    sections.map((section) => (
      <a
        href={section.href}
        aria-current={section.id === current ? 'page' : undefined}
        class:list={[
          'rounded-lg px-3 py-1.5',
          'text-sm font-medium no-underline',
          'transition-colors duration-150',
          section.id === current
            ? 'bg-(--sl-color-accent-low) text-(--sl-color-text-accent)'
            : [
                'text-(--sl-color-gray-3)',
                'hover:bg-(--sl-color-gray-6)',
                'hover:text-(--sl-color-white)',
              ],
        ]}
      >
        {section.label}
      </a>
    ))
  }
</nav>

<Default {...Astro.props}><slot /></Default>
