---
import { CompanyCard } from '@webf/sprinkles';

import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
import AmazonLogo from '../../assets/company-logos/amazon.svg';
---

<div class:list={['flex flex-wrap items-center gap-6']}>
  <CompanyCard size='md' effect='lift' companyName='Google' logo={GitHubLogo} />
  <CompanyCard
    size='md'
    effect='scale'
    companyName='GitHub'
    logo={DropboxLogo}
  />
  <CompanyCard
    size='md'
    effect='none'
    companyName='Microsoft'
    logo={AmazonLogo}
  />
</div>
